[
    {
        "key": "Ctrl+ENTER",
        "command": ["run", "/bin/sh", "-c", "mpv %F"],
        "multiselect": true,
        "multi-type": "concat"
    },
    {
        "key": "Ctrl+c",
        "command": [
            ["script-message", "set-clipboard", "%f"],
            ["print-text", "copied filepath to clipboard"]
        ],
        "multiselect": true,
        "multi-type": "concat",
        "concat-string": "\n"
    },



    {
        "key": "Ctrl+o",
        "command": ["run", "dolphin", "%p"],
        "multiselect": false
    },
    {
        "key": "Ctrl+O",
        "command": ["run", "dolphin", "%f"],
        "filter": "dir",
        "multiselect": true
    },
    {
        "key": "Ctrl+O",
        "command": ["run", "dolphin", "--select", "%f"],
        "filter": "file",
        "multiselect": true
    }
]